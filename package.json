{
  "name": "aaa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build @ktortu/aaa",
    "build:lib": "ng build @ktortu/aaa",
    "build:demo": "ng build demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test @ktortu/aaa --configuration ci --no-watch --isolate",
    "test:mutation": "ng test @ktortu/aaa --configuration mutation --no-watch",
    "test:mutation:forms": "ng test @ktortu/aaa --configuration mutation-forms --no-watch",
    "test:mutation:i18n-cdk": "ng test @ktortu/aaa --configuration mutation-i18n-cdk --no-watch",
    "test:mutation:temporal": "ng test @ktortu/aaa --configuration mutation-temporal --no-watch",
    "mutation": "stryker run",
    "mutation:forms": "stryker run stryker.forms.config.json",
    "mutation:i18n-cdk": "stryker run stryker.i18n-cdk.config.json",
    "mutation:temporal": "stryker run stryker.temporal.config.json",
    "lint": "ng lint && eslint e2e && node scripts/validate-package-integrity.js",
    "serve:debug": "ng serve --port 4300",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --project=chromium --project=firefox --project=mobile",
    "format:check": "prettier --check \"**/*.{ts,html,css,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,html,css,json,md}\"",
    "prepare": "husky",
    "deploy:demo": "npm run build:demo && npx firebase-tools deploy ",
    "publish:lib": "npm run build:lib && npm publish dist/ktortu/aaa"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/aria": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "temporal-polyfill": "^0.3.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.7",
    "ng-packagr": "^22.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  }
}
