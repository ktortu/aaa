# Normalisation des fins de ligne : LF dans le dépôt, sur toutes les plateformes.
# Évite le bruit CRLF↔LF (Windows) qui faisait échouer Prettier sur ~210 fichiers.
* text=auto eol=lf

# Fichiers binaires : jamais de normalisation de fins de ligne.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Lockfile : généré, fins de ligne LF.
package-lock.json text eol=lf
