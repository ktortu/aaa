{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "@ktortu/aaa": {
      "projectType": "library",
      "root": "projects/ktortu/aaa",
      "sourceRoot": "projects/ktortu/aaa",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ktortu/aaa/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ktortu/aaa/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ktortu/aaa/tsconfig.spec.json",
            "setupFiles": ["projects/ktortu/aaa/test-setup.ts"]
          },
          "configurations": {
            "ci": {
              "coverage": true,
              "coverageExclude": ["**/*.spec.ts"],
              "coverageReporters": ["text-summary", "html", "lcovonly"],
              "coverageThresholds": {
                "statements": 80,
                "branches": 77,
                "functions": 83,
                "lines": 83
              }
            },
            "mutation": {
              "include": ["snackbar/**/*.spec.ts"]
            },
            "mutation-forms": {
              "include": ["forms/datalist.spec.ts", "forms/field/error-messages.spec.ts"]
            },
            "mutation-i18n-cdk": {
              "include": ["i18n/i18n.spec.ts", "cdk/id-generator.spec.ts"]
            },
            "mutation-temporal": {
              "include": ["forms/temporal/temporal-date.pipe.spec.ts"]
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ktortu/aaa/**/*.ts", "projects/ktortu/aaa/**/*.html"],
            "eslintConfig": "projects/ktortu/aaa/eslint.config.js"
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo/public"
              }
            ],
            "styles": ["projects/demo/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4210
          },
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["projects/demo/src/test-setup.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/demo/**/*.ts", "projects/demo/**/*.html"],
            "eslintConfig": "projects/demo/eslint.config.js"
          }
        }
      }
    }
  }
}
